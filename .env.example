# =============================================================================
# CAREEROS — ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
#
# Variables marked [REQUIRED] must be set for the service to start.
# Variables marked [PHASE N] are only needed from that phase onward.
# Variables marked [OPTIONAL] have usable defaults.
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# [REQUIRED] PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://careeros:careeros@postgres:5432/careeros

# [REQUIRED] Synchronous connection string for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://careeros:careeros@postgres:5432/careeros

# PostgreSQL credentials (used by docker-compose to init the database)
POSTGRES_DB=careeros
POSTGRES_USER=careeros
POSTGRES_PASSWORD=careeros


# =============================================================================
# REDIS
# =============================================================================

# [REQUIRED] Redis connection string
REDIS_URL=redis://redis:6379/0

# Celery broker and result backend (usually same as REDIS_URL)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1


# =============================================================================
# AUTHENTICATION
# =============================================================================

# [REQUIRED] Secret key for signing JWT tokens — generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET=change-this-to-a-strong-random-secret-in-production

# JWT token configuration
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_ALGORITHM=HS256

# [PHASE 7] Google OAuth 2.0
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback


# =============================================================================
# LLM PROVIDER
# [PHASE 4+] Required for ATS semantic matching and AI generation
# =============================================================================

# LLM provider: openai | gemini
LLM_PROVIDER=openai

# Model name (configurable per provider)
# OpenAI examples: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Gemini examples: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
LLM_MODEL=gpt-4o-mini

# Provider API key
# LLM_API_KEY=sk-...

# Optional: override API base URL (for OpenAI-compatible endpoints)
# LLM_BASE_URL=


# =============================================================================
# EMBEDDING PROVIDER
# [PHASE 5+] Required for RAG pipeline
# =============================================================================

# Embedding provider: openai
EMBEDDING_PROVIDER=openai

# Embedding model
# OpenAI examples: text-embedding-3-small (1536d), text-embedding-3-large (3072d)
EMBEDDING_MODEL=text-embedding-3-small

# Dimensions must match the model output
EMBEDDING_DIMENSIONS=1536

# Uses same API key as LLM by default; override if different
# EMBEDDING_API_KEY=sk-...


# =============================================================================
# RERANKER
# [PHASE 5+] Required for RAG pipeline
# =============================================================================

# Cross-encoder model (sentence-transformers compatible)
# Lighter: cross-encoder/ms-marco-MiniLM-L-6-v2
# Heavier: BAAI/bge-reranker-large
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2


# =============================================================================
# RAG PIPELINE CONFIGURATION
# [PHASE 5+]
# =============================================================================

RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K_RETRIEVAL=20
RAG_TOP_K_RERANKED=5
RAG_HYBRID_ALPHA=0.6
RAG_FAITHFULNESS_THRESHOLD=0.7
RAG_EMBEDDING_QUERY_CACHE_SIZE=256


# =============================================================================
# ATS SCORING WEIGHTS
# [PHASE 4+] All weights must sum to 1.0
# =============================================================================

ATS_WEIGHT_KEYWORD=0.25
ATS_WEIGHT_SKILL=0.25
ATS_WEIGHT_EXPERIENCE=0.20
ATS_WEIGHT_PROJECT=0.10
ATS_WEIGHT_EDUCATION=0.10
ATS_WEIGHT_STRUCTURE=0.05
ATS_WEIGHT_FORMATTING=0.05


# =============================================================================
# FILE STORAGE
# =============================================================================

# Storage backend: local | s3
STORAGE_BACKEND=local

# Local storage path (relative to backend working directory)
STORAGE_LOCAL_PATH=./storage

# [PRODUCTION] S3-compatible storage
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=careeros-uploads
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

# Maximum upload file size in bytes (default: 10MB)
MAX_UPLOAD_SIZE_BYTES=10485760


# =============================================================================
# FRONTEND
# =============================================================================

# [REQUIRED for frontend] Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000


# =============================================================================
# APPLICATION
# =============================================================================

# Environment: development | production
APP_ENV=development

# Backend host and port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# =============================================================================
# OBSERVABILITY
# [PHASE 7+] Optional
# =============================================================================

# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# PROMETHEUS_ENABLED=true
# LANGFUSE_SECRET_KEY=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
